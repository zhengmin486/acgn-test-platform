# 复制为 .env 并填写真实值；.env 已被 .gitignore 忽略，禁止提交。

# 数据库连接串（不设置时默认使用下面的 SQLite 值）
# DATABASE_URL=sqlite:///./local_dev.db

# MySQL（目标生产配置，等本机 MySQL 服务可用后启用；密码只写在本机 .env）：
# DATABASE_URL=mysql+pymysql://acgn_app:你的密码@127.0.0.1:3306/acgn_test_platform?charset=utf8mb4

# ---------- 认证与访问控制 ----------
# 会话 Cookie 签名密钥：务必改成随机长字符串（例如 python -c "import secrets;print(secrets.token_urlsafe(48))"）
# AUTH_SECRET_KEY=请替换为随机密钥
# 会话有效期（秒），默认 8 小时
# SESSION_MAX_AGE_SECONDS=28800

# users 表为空时创建的初始账号（仅首次初始化生效，不会覆盖已有账号）。
# 部署前务必修改默认口令，或用 scripts/create_user.py 自行创建账号。
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=请替换为强密码
# DEFAULT_USER_USERNAME=demo
# DEFAULT_USER_PASSWORD=请替换为强密码

# ---------- 邮箱验证（可插拔） ----------
# 总开关：置为 false 后注册即登录、登录不再校验邮箱，行为完全退回加该功能之前
# EMAIL_VERIFICATION_ENABLED=true
# 验证令牌有效期（秒），默认 24 小时
# EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
# 找回密码令牌有效期（秒），默认 1 小时（权限更高，刻意比验证邮件短）
# PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# 重发邮件的冷却时间（秒），验证与找回共用
# EMAIL_RESEND_COOLDOWN_SECONDS=60
# 站点对外基址（如 https://acgn.example.com）；留空时取当前请求的 host
# PUBLIC_BASE_URL=

# ---------- 邮件发送（SMTP，全部留空则不真发） ----------
# SMTP_HOST 与 SMTP_FROM_ADDRESS 都为空 = 不发送真实邮件：
# 一次性链接写入日志，并可在待验证页面 / 找回密码页 / 管理员页面手动生成。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# 465 端口用 SMTP_USE_SSL=true；587 端口用 SMTP_USE_TLS=true（STARTTLS）
# SMTP_USE_SSL=false
# SMTP_USE_TLS=true
# SMTP_FROM_ADDRESS=no-reply@example.com
# SMTP_FROM_NAME=ACGN 平台

# ---------- 短信验证码（手机绑定 / 解绑，全部留空则不真发） ----------
# SMS_API_URL 与 SMS_API_KEY 都为空 = 不发送真实短信：验证码写日志，并在
# /settings/security 页面上直接显示（仅本地 / 测试环境可接受）。
# 接入具体服务商时只需要改 app/sms.py 的 _request_body 拼装，业务代码不动。
# SMS_API_URL=https://sms.example.com/send
# SMS_API_KEY=
# SMS_SIGN_NAME=Otaku
# 验证码有效期（秒）与重发冷却（秒）
# SMS_CODE_TTL_SECONDS=300
# SMS_RESEND_COOLDOWN_SECONDS=60

# ---------- 注册控制 ----------
# 注册模式：
#   invite（默认）= 关闭公开注册，/register 必须提供有效邀请码
#                   （管理员在 /admin/invites 生成，或 scripts/create_invite.py 批量生成）；
#   open          = 任何人可自助注册（旧行为）。
# 任何其它取值（含拼错、留空）都按 invite 处理——公开注册是敏感开关，
# 只有显式 open 才放开发布。
# REGISTRATION_MODE=invite

# ---------- 开发种子数据 ----------
# contents 为空时是否写入开发假数据（app/fake_data.py）。
# 开发 / 测试保持 true；上线置 false 用干净库，真实数据经数据同步灌入。
# 注意：本开关只管演示内容，users 表为空时仍会创建初始账号（见上）。
# SEED_DEMO_DATA=true

# ---------- 数据库备份（scripts/backup_db.py，详见 README 13.1） ----------
# 备份输出目录（相对项目根或绝对路径，可放其它盘符）与保留份数（0 = 不清理）
# BACKUP_DIR=backups
# BACKUP_RETAIN=14

# ---------- 封面图（Bangumi 导入时下载，详见 README 13.4） ----------
# 封面本地存储目录：统一挂载到 /covers，Content.image_url 存 /covers/... 站内地址。
# 默认为项目内相对路径；想放到其它盘符（如 D:/acgn-covers）改成绝对路径即可。
# COVER_STORAGE_DIR=app/static/covers
# 导入时是否下载封面；置 false 则只记录远端 URL（不推荐，热链易失效）
# COVER_DOWNLOAD_ENABLED=true

# ---------- 封面图片管线（app/media.py，详见 README 13.4） ----------
# 列表缩略图宽度（px）：按需生成 400px WebP，缓存到 COVER_STORAGE_DIR/thumbs/
# COVER_THUMB_WIDTH=400
# 详情页全图最大宽度（px）：只缩不放
# COVER_FULL_MAX_WIDTH=1200
# 详情页全图体积预算（字节）：按画质阶梯逐档压缩到达标，保底接受最小画质
# COVER_FULL_MAX_BYTES=409600
# 管理员上传封面的体积上限（字节），超限直接拒绝
# COVER_UPLOAD_MAX_BYTES=5242880
# 图片对外基址前缀：留空走站内 /media/... 端点；将来切 CDN/COS 只改这一项
# MEDIA_BASE_URL=

# ---------- 资讯图片（Aniplex 导入时下载正文图与头图） ----------
# 资讯图片目录：挂载到 /article-images，Article.image_url 与正文 [图] 行存站内地址。
# 默认为项目内相对路径；想放到其它盘符改成绝对路径即可。
# ARTICLE_IMAGE_STORAGE_DIR=app/static/article_images
# 单张资讯图体积上限（字节）：只认魔术字节，超限的图保留源站外链
# ARTICLE_IMAGE_MAX_BYTES=5242880

# ---------- 数据库连接池（仅 MySQL 等非 SQLite 驱动生效） ----------
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=1800
# DB_POOL_PRE_PING=true

# ---------- 对外 API 分页上限 ----------
# API_CONTENTS_MAX_PAGE_SIZE=500
# API_ARTICLES_MAX_PAGE_SIZE=100
# API_SEARCH_MAX_PAGE_SIZE=100
# API_SCHEDULE_MAX_PAGE_SIZE=100
# API_TAGS_MAX_LIMIT=2000
# API_SYNC_RUNS_MAX_LIMIT=200

# ---------- 安全响应头 ----------
# SECURITY_HEADERS_ENABLED=true
# X_FRAME_OPTIONS=DENY（可改 SAMEORIGIN，置空关闭）

# ---------- 静态资源与图片缓存（秒；0=不输出 Cache-Control） ----------
# STATIC_CACHE_MAX_AGE=86400
# MEDIA_CACHE_MAX_AGE=604800

# ---------- 上传 / 图片目录容量护栏 ----------
# MEDIA_STORAGE_MAX_BYTES=8589934592（默认 8 GiB，超出按可再生优先清理）
# AVATAR_STORAGE_MAX_BYTES=268435456（默认 256 MiB）
# MEDIA_STORAGE_CHECK_INTERVAL_SECONDS=3600
# MEDIA_TEMP_MAX_AGE_SECONDS=3600

# ---------- HTTP 压缩（默认关：站点流量大头是已压缩的 WebP 图片） ----------
# GZIP_ENABLED=false
# GZIP_COMPRESS_LEVEL=5
# GZIP_MINIMUM_SIZE=1024

# ---------- 日志 ----------
# 应用日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
# LOG_LEVEL=INFO

# ---------- 多源资讯：停用开关 ----------
# 逗号分隔的源 key（如 "gamersky,natalie_comic"），命中的源整源跳过（不发请求）。
# 现有 key：natalie_comic / animeanime / 4gamer / inside / gamespark / lisani /
#           lnnews / gcores / acgch / chuapp / gamersky
# NEWS_DISABLED_SOURCES=
